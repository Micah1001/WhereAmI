<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity"
    android:background="#B0EFB3">

    <TextView
        android:id="@+id/textView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0086FF"
        android:padding="15dp"
        android:text="@string/welcome_to_find_your_location"
        android:textColor="#FF3B00"
        android:textSize="30sp"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="0dp" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0086FF"
        android:padding="15dp"
        android:text="@string/click_the_start_button_to_find_your_current_location"
        android:textColor="#FF3B00"
        android:textSize="25sp"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="114dp" />

    <Button
        android:id="@+id/startbtn"
        android:layout_width="162dp"
        android:layout_height="106dp"
        android:layout_gravity="center"
        android:padding="15dp"
        android:text="@string/start"
        android:textSize="25sp"
        tools:layout_editor_absoluteX="124dp"
        tools:layout_editor_absoluteY="259dp" />

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="200dp"
        android:layout_height="300dp"
        app:layout_constraintTop_toBottomOf="@id/showLocationButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>